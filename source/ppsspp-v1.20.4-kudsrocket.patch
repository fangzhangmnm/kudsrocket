+// The IR interpreter's loads / stores are unchecked by design (native builds rely on the segfault handler); here an out-of-range address
+// silently reads / corrupts other heap data or traps the whole wasm module ("Out of bounds memory access" — Clannad's boot code does this,
+// the classic interpreter survives because Read_U32 validates). Bounds-check the masked address: reads outside → 0, writes → dropped.
+#if defined(__EMSCRIPTEN__)
+static inline bool KrMemOk(u32 addr, u32 size) { return (addr & Memory::MEMVIEW32_MASK) + size <= 0x0A000000u; }
+static inline u8 KrRead8(u32 a) { return KrMemOk(a, 1) ? Memory::ReadUnchecked_U8(a) : 0; }
+static inline u16 KrRead16(u32 a) { return KrMemOk(a, 2) ? Memory::ReadUnchecked_U16(a) : 0; }
+static inline u32 KrRead32(u32 a) { return KrMemOk(a, 4) ? Memory::ReadUnchecked_U32(a) : 0; }
+static inline float KrReadF(u32 a) { return KrMemOk(a, 4) ? Memory::ReadUnchecked_Float(a) : 0.0f; }

+static inline void KrWrite32(u32 v, u32 a) { if (KrMemOk(a, 4)) Memory::WriteUnchecked_U32(v, a); }
+static inline void KrWriteF(float v, u32 a) { if (KrMemOk(a, 4)) Memory::WriteUnchecked_Float(v, a); }

+// KudsRocket patch: oracle mode for reference runs of real games (off unless KR_DUMP_DIR is set).
+// Dumps the displayed frame as PNG every KR_DUMP_EVERY_MS of emulated time, and taps one button
+// (KR_PRESS_SEQ, see below) every KR_PRESS_EVERY_MS after KR_PRESS_AFTER_MS.
+// Emulated time, not wall time: headless runs unthrottled.
+static void KrOracleTick() {
+	static const char *dir = getenv("KR_DUMP_DIR");
+	if (!dir || !gpuDebug)
+		return;
+	auto envMs = [](const char *name, double def) { const char *v = getenv(name); return v ? atof(v) : def; };
+	static const double dumpEvery = envMs("KR_DUMP_EVERY_MS", 2000.0);
+	static const double pressEvery = envMs("KR_PRESS_EVERY_MS", 0.0);
+	static const double pressAfter = envMs("KR_PRESS_AFTER_MS", 15000.0);
+	static std::vector<u32> seq = [] {
+		// KR_PRESS_SEQ: comma list (up,down,left,right,circle,cross,square,triangle,start,select); after the list, the last one repeats.
+		std::vector<u32> out;
+		std::string spec = getenv("KR_PRESS_SEQ") ? getenv("KR_PRESS_SEQ") : (getenv("KR_PRESS_BUTTON") ? getenv("KR_PRESS_BUTTON") : "circle");
+		size_t pos = 0;
+		while (pos <= spec.size()) {
+			size_t comma = spec.find(',', pos);
+			std::string name = spec.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+			u32 bit = name == "up" ? CTRL_UP : name == "down" ? CTRL_DOWN : name == "left" ? CTRL_LEFT : name == "right" ? CTRL_RIGHT
+				: name == "cross" ? CTRL_CROSS : name == "square" ? CTRL_SQUARE : name == "triangle" ? CTRL_TRIANGLE
+				: name == "start" ? CTRL_START : name == "select" ? CTRL_SELECT : CTRL_CIRCLE;
+			out.push_back(bit);
+			if (comma == std::string::npos) break;
+			pos = comma + 1;
+		}
+		return out;
+	}();
+	static size_t seqIdx = 0;
+	static u32 button = 0;
+	static double nextDump = 0.0, nextPress = pressAfter, releaseAt = -1.0;
+	static int frameNo = 0;
+	const double t = CoreTiming::GetGlobalTimeUs() / 1000.0;
+	if (releaseAt >= 0.0 && t >= releaseAt) {
+		__CtrlUpdateButtons(0, button);
+		releaseAt = -1.0;
+	}
+	if (pressEvery > 0.0 && t >= nextPress) {
+		button = seq[std::min(seqIdx, seq.size() - 1)];
+		seqIdx++;
+		__CtrlUpdateButtons(button, 0);
+		releaseAt = t + 100.0;
+		nextPress = t + pressEvery;
+	}
+	if (t >= nextDump) {
+		nextDump = t + dumpEvery;
+		GPUDebugBuffer buf;
+		const bool gotFb = gpuDebug->GetCurrentFramebuffer(buf, GPU_DBG_FRAMEBUF_DISPLAY, -1);
+		if (getenv("KR_DUMP_VERBOSE")) fprintf(stderr, "[kr] t=%.0fms getFb=%d\n", t, (int)gotFb);
+		if (gotFb) {
+			u8 *temp = nullptr;
+			u32 w = 480, h = 272;  // in: max size, out: actual size
+			const u8 *rgb = ConvertBufferToScreenshot(buf, false, temp, w, h);
+			if (getenv("KR_DUMP_VERBOSE") && !rgb) fprintf(stderr, "[kr] convert failed\n");
+			if (rgb) {
+				char name[512];
+				snprintf(name, sizeof(name), "%s/frame_%04d_%07.0fms.png", dir, frameNo++, t);
+				const bool saved = Save888RGBScreenshot(Path(std::string(name)), ScreenshotFormat::PNG, rgb, w, h);
+				if (getenv("KR_DUMP_VERBOSE")) fprintf(stderr, "[kr] %ux%u saved=%d %s\n", w, h, (int)saved, name);
+			}
+			delete[] temp;
+		}
+	}
+}
